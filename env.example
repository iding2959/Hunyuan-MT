# vLLM OpenAI 兼容服务地址
OPENAI_BASE_URL=http://localhost:8021/v1
# vLLM API Key（本地可用占位，如无需鉴权保持 EMPTY）
OPENAI_API_KEY=EMPTY
# 服务模型名称（需与 vLLM served-model-name 保持一致）
OPENAI_MODEL=Hunyuan-MT-Chimera-7B

# FastAPI 监听配置
API_HOST=0.0.0.0
API_PORT=8030
# 是否开启热重载（仅监控 services 目录）
API_RELOAD=true

# vLLM 启动脚本与探活
VLLM_START_SCRIPT=vllm_start.sh
# 启动等待超时时间（秒）
VLLM_READY_TIMEOUT=60
# 启动探测间隔（秒）
VLLM_PROBE_INTERVAL=2

# 日志配置：按天切分，保留 30 天
LOG_DIR=logs
LOG_LEVEL=INFO
